{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchVerdict",
        "digest"
      ],
      "properties": {
        "batchVerdict": {
          "const": "invalid"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "digest"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "caseId",
              "verdict"
            ],
            "properties": {
              "caseId": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "verified",
                  "refuted",
                  "undetermined",
                  "invalid"
                ]
              }
            }
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ]
}
