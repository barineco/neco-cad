{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "logicalManifestDigest", "corpusResults", "processErrorCount", "processErrors", "realPasses", "sequentialStaging", "laneResults"],
  "properties": {
    "schema": {"const": "neco.cad.completion-report.v1"},
    "logicalManifestDigest": {"$ref": "#/$defs/sha256"},
    "descriptorDigest": {"$ref": "#/$defs/sha256"},
    "sharedNormalCorpus": {"const": true},
    "corpusResults": {"$ref": "#/$defs/corpusRun"},
    "processErrorCount": {"const": 0}, "processErrors": {"type": "array", "maxItems": 0},
    "realPasses": {"const": 2}, "sequentialStaging": {"const": true},
    "laneResults": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "corpusExecution": {"type": "object", "additionalProperties": false, "required": ["status", "coverage"], "properties": {"status": {"const": "passed"}, "coverage": {"type": "object", "required": ["schema", "status", "shardCaseCount", "producerMaxBatchCases", "buckets"], "properties": {"schema": {"const": "neco.cad.coverage-report.v1"}, "status": {"const": "passed"}}}}},
        "observationVerification": {"type": "object", "additionalProperties": false, "required": ["status", "normalCorpusId", "separateFailureCorpora", "corpora"], "properties": {"status": {"const": "passed"}, "normalCorpusId": {"const": "cad"}, "separateFailureCorpora": {"const": true}, "corpora": {"$ref": "#/$defs/corpora"}}},
        "soundnessTheorem": {"type": "object", "additionalProperties": false, "required": ["neco.cad"], "properties": {"neco.cad": {"type": "object", "additionalProperties": false, "required": ["status", "outputDigest", "text"], "properties": {"status": {"const": "passed"}, "outputDigest": {"$ref": "#/$defs/sha256"}, "text": {"type": "string"}}}}},
        "publicApiParity": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["verified", "resultMatched", "report"], "properties": {"verified": {"const": true}, "resultMatched": {"const": true}, "report": {"$ref": "cad-public-api-parity-result.schema.json"}}}},
        "mutationRejection": {"type": "object", "additionalProperties": false, "required": ["exact-chart", "face-atom-covering", "finite-surface-representation", "certified-chord-bound", "mesh-judgment"], "properties": {"exact-chart": {"$ref": "#/$defs/mutation"}, "face-atom-covering": {"$ref": "#/$defs/mutation"}, "finite-surface-representation": {"$ref": "#/$defs/mutation"}, "certified-chord-bound": {"$ref": "#/$defs/mutation"}, "mesh-judgment": {"$ref": "#/$defs/mutation"}}},
        "invalidProtocol": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/checkerInvalid"}, {"$ref": "#/$defs/observerInvalid"}]}},
        "repeatability": {"type": "object", "additionalProperties": false, "required": ["status", "realPasses", "sequential", "corpora", "checkerCaseRowsMatched", "shardSemanticsMatched"], "properties": {"status": {"const": "passed"}, "realPasses": {"const": 2}, "sequential": {"const": true}, "corpora": {"$ref": "#/$defs/corpora"}, "checkerCaseRowsMatched": {"const": true}, "shardSemanticsMatched": {"const": true}}}
      },
      "oneOf": [
        {"required": ["observationVerification", "soundnessTheorem", "publicApiParity", "mutationRejection", "invalidProtocol", "corpusExecution", "repeatability"]},
        {"required": ["repeatability"], "maxProperties": 1}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "family": {"enum": ["exact-chart", "face-atom-covering", "finite-surface-representation", "certified-chord-bound", "mesh-judgment"]},
    "corpus": {"type": "object", "additionalProperties": false, "required": ["requestDigest", "observationDigest", "checkerDigest", "verdictCounts", "observationCategoryCounts"], "properties": {"requestDigest": {"$ref": "#/$defs/sha256"}, "observationDigest": {"$ref": "#/$defs/sha256"}, "checkerDigest": {"$ref": "#/$defs/sha256"}, "verdictCounts": {"type": "object", "additionalProperties": false, "properties": {"verified": {"type": "integer", "minimum": 0}, "refuted": {"type": "integer", "minimum": 0}, "undetermined": {"type": "integer", "minimum": 0}, "invalid": {"type": "integer", "minimum": 0}}}, "observationCategoryCounts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}},
    "corpora": {"type": "object", "additionalProperties": false, "required": ["cad", "cad-typed-failure"], "properties": {"cad": {"allOf": [{"$ref": "#/$defs/corpus"}, {"properties": {"verdictCounts": {"type": "object", "additionalProperties": false, "required": ["verified"], "properties": {"verified": {"type": "integer", "minimum": 1}}}}}]}, "cad-typed-failure": {"allOf": [{"$ref": "#/$defs/corpus"}, {"properties": {"verdictCounts": {"type": "object", "additionalProperties": false, "required": ["undetermined"], "properties": {"undetermined": {"type": "integer", "minimum": 1}}}}}]}, "cad-mesh-rejected": {"allOf": [{"$ref": "#/$defs/corpus"}, {"properties": {"verdictCounts": {"type": "object", "additionalProperties": false, "required": ["verified"], "properties": {"verified": {"type": "integer", "minimum": 1}}}}}]}}},
    "corpusRun": {"type": "object", "additionalProperties": false, "required": ["corpora", "shards", "processErrorCount"], "properties": {"corpora": {"$ref": "#/$defs/corpora"}, "processErrorCount": {"const": 0}, "shards": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["corpusId", "shardIndex", "caseCount", "requestDigest", "observationDigest", "checkerDigest", "checkerCases", "publicApiParity", "resultMatched"], "properties": {"corpusId": {"enum": ["cad", "cad-typed-failure", "cad-mesh-rejected"]}, "shardIndex": {"type": "integer", "minimum": 0}, "caseCount": {"type": "integer", "minimum": 1, "maximum": 200}, "requestDigest": {"$ref": "#/$defs/sha256"}, "observationDigest": {"$ref": "#/$defs/sha256"}, "checkerDigest": {"$ref": "#/$defs/sha256"}, "checkerCases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["caseId", "verdict"], "properties": {"caseId": {"type": "string", "minLength": 1}, "verdict": {"enum": ["verified", "refuted", "undetermined", "invalid"]}}}}, "publicApiParity": {"$ref": "cad-public-api-parity-result.schema.json"}, "resultMatched": {"const": true}}}}}},
    "mutation": {"type": "object", "additionalProperties": false, "required": ["classification", "originalDigest", "mutatedDigest", "equivalentDigest", "equivalentVerified", "equivalentClassification", "checkerResult", "observerResult", "equivalentCheckerResult", "equivalentObserverResult", "controlPrecondition", "publicApiObservation"], "properties": {"classification": {"type": "object", "additionalProperties": false, "required": ["observed", "expected"], "properties": {"observed": {"const": "refuted"}, "expected": {"const": "refuted"}}}, "originalDigest": {"$ref": "#/$defs/sha256"}, "mutatedDigest": {"$ref": "#/$defs/sha256"}, "equivalentDigest": {"$ref": "#/$defs/sha256"}, "equivalentVerified": {"const": true}, "equivalentClassification": {"type": "object", "additionalProperties": false, "required": ["observed", "expected"], "properties": {"observed": {"const": "verified"}, "expected": {"const": "verified"}}}, "checkerResult": {"$ref": "cad-checker-result.schema.json"}, "observerResult": {"$ref": "cad-reconciliation-result.schema.json"}, "equivalentCheckerResult": {"$ref": "cad-checker-result.schema.json"}, "equivalentObserverResult": {"$ref": "cad-reconciliation-result.schema.json"}, "controlPrecondition": {"type": "object"}, "publicApiObservation": {"oneOf": [{"type": "null"}, {"$ref": "cad-mesh-api-probe-result.schema.json"}]}}},
    "checkerInvalid": {"type": "object", "additionalProperties": false, "required": ["family", "vector", "expected", "observed", "classification", "inputDigest", "checkerResult", "observerResult"], "properties": {"family": {"$ref": "#/$defs/family"}, "vector": {"type": "string", "minLength": 1}, "expected": {"const": "invalid"}, "observed": {"const": "invalid"}, "classification": {"enum": ["batchInvalid", "caseInvalid"]}, "inputDigest": {"$ref": "#/$defs/sha256"}, "checkerResult": {"$ref": "cad-checker-result.schema.json"}, "observerResult": {"$ref": "cad-reconciliation-result.schema.json"}}},
    "observerInvalid": {"type": "object", "additionalProperties": false, "required": ["family", "vector", "expected", "observed", "resultDigest", "exitCode", "failure"], "properties": {"family": {"$ref": "#/$defs/family"}, "vector": {"type": "string", "minLength": 1}, "expected": {"const": "observerRejection"}, "observed": {"const": "observerRejection"}, "inputDigest": {"$ref": "#/$defs/sha256"}, "resultDigest": {"$ref": "#/$defs/sha256"}, "exitCode": {"const": 2}, "failure": {"$ref": "cad-observer-failure.schema.json"}}}
  },
  "x-invariants": ["the seven lanes apply only to the normal cad corpus", "typedFailure stays separately undetermined and mesh rejected is a separately verified failure claim", "both repeatability passes compare actual request, observation and canonical checker full case rows", "mathematical controls change canonical bytes and require refuted/verified outcomes from the same real checker", "soundnessTheorem records the actual checker soundness entry output and its digest"]
}
